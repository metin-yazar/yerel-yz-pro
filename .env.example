# Sağlayıcı seçimi: "ollama" (tam bağımsız yerel model) veya "gemini"
AI_PROVIDER=ollama

# Tam bağımsız yerel LLM ayarları (Ollama / vLLM / OpenAI uyumlu sunucu)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# İsteğe bağlı bulut modeli (Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Veritabanı ve otonom veri üretim ayarları
DATABASE_PATH=/app/data/memory.db
AUTO_LEARN_ENABLED=true
